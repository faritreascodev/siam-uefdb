// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for MVP Auth
enum UserStatus {
  PENDIENTE_APROBACION
  ACTIVO
  BLOQUEADO
  RECHAZADO
}

enum Parentesco {
  PADRE
  MADRE
  ABUELO_ABUELA
  TIO_TIA
  TUTOR_LEGAL
}

// User model with authentication and role relationship
model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String // Hashed password with bcrypt
  firstName String?
  lastName  String?
  isActive  Boolean @default(true) // Deprecated in favor of status, keep for backward compatibility

  // New fields for MVP Auth
  cedula     String?     @unique
  telefono   String?
  direccion  String?
  parentesco Parentesco?
  status     UserStatus  @default(PENDIENTE_APROBACION)

  // Approval tracking
  approvedBy    String?
  approvedAt    DateTime?
  rejectionNote String?

  // Password Recovery (Option B)
  tempPassword       String?
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Many-to-Many relationship with Role
  roles UserRole[]

  // One-to-Many relationship with Recovery Requests
  recoveryRequests PasswordRecoveryRequest[]

  // Admission Module Relations
  applications          Application[]
  notifications         Notification[]
  assignedApplications  Application[]  @relation("AssignedApplications")
  processedApplications Application[]  @relation("ProcessedApplications")

  @@index([email])
  @@map("users")
}

// Role model for RBAC (Role-Based Access Control)
model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., 'user', 'superadmin', 'moderator'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-Many relationship with User
  users UserRole[]

  @@index([name])
  @@map("roles")
}

// Join table for User-Role many-to-many relationship
model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// Password Recovery Requests (Option B)
model PasswordRecoveryRequest {
  id     String  @id @default(uuid())
  userId String
  cedula String
  email  String
  motivo String?
  status String  @default("PENDIENTE") // PENDIENTE, APROBADA, RECHAZADA

  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("password_recovery_requests")
}

// ========================================
// ADMISSION MODULE
// ========================================

// Enums for Admission
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CURSILLO_SCHEDULED // Cursillo programado (solo 8vo y 1ero BGU)
  CURSILLO_APPROVED // Cursillo aprobado
  CURSILLO_REJECTED // Cursillo no aprobado
  REQUIRES_CORRECTION
  APPROVED
  PAYMENT_UPLOADED // Pago cargado por el apoderado (NUEVO)
  PAYMENT_VALIDATED // Pago de matrícula validado (NUEVO)
  MATRICULATED // Estudiante matriculado con paralelo asignado (NUEVO)
  REJECTED
}

enum CursilloResult {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  M
  F
  OTHER
}


enum DocumentType {
  STUDENT_ID
  REPRESENTATIVE_ID
  STUDENT_PHOTO
  GRADE_CERTIFICATE
  UTILITY_BILL
  PAYMENT_RECEIPT
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_DRAFT_SAVED
  CORRECTION_REQUIRED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_UNDER_REVIEW
  DOCUMENT_REQUIRED
  MATRICULATED
  PAYMENT_UPLOADED
  PAYMENT_VALIDATED
  PAYMENT_REJECTED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EnrollmentType {
  NEW_STUDENT
  RETURNING_STUDENT // Estudiante Antiguo (aplica para renovación de matrícula)
}

enum AcademicStatus {
  PASSED               // Aprobado directo
  SUPLETORIO_PENDING   // Promedio 4.00 - 6.99
  SUPLETORIO_PASSED
  SUPLETORIO_FAILED
  REMEDIAL_PENDING     // Reprobó supletorio (15 días antes)
  REMEDIAL_PASSED
  REMEDIAL_FAILED
  GRACIA_PENDING       // Reprobó remedial en una sola asignatura
  GRACIA_PASSED
  FAILED_YEAR          // Promedio < 4.00 o reprobó últimas instancias
}

// Application (Solicitud de Admisión)
model Application {
  id          String            @id @default(uuid())
  status      ApplicationStatus @default(DRAFT)
  submittedAt DateTime?

  // Tipo de Estudiante (Nuevo o Antiguo)
  enrollmentType EnrollmentType @default(NEW_STUDENT)

  // Datos del Estudiante
  studentFirstName   String?
  studentLastName    String?
  studentCedula      String?   @unique
  studentBirthDate   DateTime?
  studentBirthPlace  Json? // { country, province, city }
  studentGender      Gender?
  studentNationality String? // NUEVO: Nacionalidad
  studentAddress     String?
  studentSector      String?
  studentPhone       String?
  studentEmail       String?

  // Datos Médicos
  bloodType         String?
  hasDisability     Boolean @default(false)
  disabilityDetail  String?
  needsSpecialCare  Boolean @default(false)
  specialCareDetail String?

  // Datos Académicos
  gradeLevel         String?
  shift              String?
  specialty          String? // Solo para Bachillerato (Ciencias, Técnico, etc.)
  previousSchool     String?
  lastYearAverage    Decimal?
  hasRepeatedYear    Boolean  @default(false)
  repeatedYearDetail String?

  // Datos Familiares (JSON para flexibilidad)
  fatherData         Json? // { names, cedula, phone, email, occupation, ... }
  motherData         Json?
  representativeData Json? // { names, cedula, relationship, ... }

  // Documentos
  documents ApplicationDocument[]

  // Relación con el Apoderado (usuario que crea la solicitud)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Asignación a Directivo (para escalamiento)
  assignedToId String?
  assignedTo   User?     @relation("AssignedApplications", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  // Secretaria que procesó la solicitud
  processedById String?
  processedBy   User?     @relation("ProcessedApplications", fields: [processedById], references: [id])
  processedAt   DateTime?

  // Cursillo (solo para 8vo y 1ero BGU de instituciones externas)
  cursilloScheduled   Boolean        @default(false)
  cursilloDate        DateTime?
  cursilloResult      CursilloResult @default(PENDING)
  cursilloNotes       String? // Observaciones del cursillo
  cursilloSessionId   String?        // Referencia a sesión global (legacy, ahora usar enrollments)

  // Ideario UEFDB
  acceptedIdeario Boolean   @default(false)
  acceptedAt      DateTime?

  // Datos de Pago de Matrícula
  paymentDate              DateTime?
  paymentReference         String?
  paymentAmount            Decimal?
  paymentValidatedAt       DateTime? // Cuando la secretaría validó el pago
  paymentValidatedBy       String?   // ID del usuario que validó
  paymentRejectionReason   String?   // Motivo de rechazo del pago

  // Asignación de Paralelo (para control de cupos específicos)
  assignedParallel String? // Ej: "A", "B", "Unico"

  // Observaciones del Admin
  adminNotes        String?
  rejectionReason   String?
  correctionRequest String?
  internalComments  Json? // NUEVO: [{ userId, userName, comment, createdAt }]

  // Notificaciones relacionadas
  notifications Notification[]

  // Contactos adicionales (Máximo 3 por app)
  extraContacts ExtraContact[]

  // Inscripciones en sesiones del cursillo
  cursilloEnrollments CursilloEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@map("applications")
}

// Documentos de la Solicitud
model ApplicationDocument {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  documentType DocumentType
  fileName     String
  fileUrl      String // Ruta en storage
  fileSize     Int // bytes
  mimeType     String // application/pdf, image/jpeg, etc.

  uploadedAt DateTime @default(now())

  @@index([applicationId])
  @@map("application_documents")
}

// Sistema de Notificaciones In-App
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  priority NotificationPriority @default(NORMAL)
  title    String
  message  String

  // Relación opcional con la solicitud
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  actionUrl String? // NUEVO: URL para redirección directa

  // Estado de lectura
  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ========================================
// QUOTA MANAGEMENT MODULE
// ========================================

model AdmissionQuota {
  id String @id @default(uuid())

  // Configuración
  level     String // Ej: "Inicial 1 (3 años)", "1ero EGB"
  parallel  String // Ej: "Único", "A", "B"
  shift     String // "Matutina" / "Vespertina"
  specialty String? // Ej: "Ciencias", "Técnico Informática"

  // Cupos
  totalQuota Int // Cupos totales configurados

  // Año lectivo
  academicYear String @default("2026-2027")

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Índice único para evitar duplicados
  @@unique([level, parallel, shift, specialty, academicYear], name: "quotaIdentifier")
  @@map("admission_quotas")
}

// ========================================
// CURSILLO MODULE
// ========================================

// Una sesión/materia del cursillo (configurable por año lectivo)
model CursilloSession {
  id String @id @default(uuid())

  // Identificación de la materia
  subject     String // "Lengua y Literatura", "Matemáticas", "Inglés", etc.
  subjectCode String // "LENGUA", "MATE", "INGLES", "FISICA", "QUIMICA", "PROGRAMACION"

  // Para qué grado aplica
  gradeLevel String // "8vo_basico" | "1ro_bachillerato"
  // Para qué especialidad aplica (null = todas las especialidades del grado)
  specialty  String? // Solo "Técnico Informática" para Programación

  // Docente responsable
  teacherName  String?
  teacherEmail String?

  // Datos de la sesión
  teamsLink       String  @default("https://teams.microsoft.com/meet/24893552174366?p=sbOFw5Mv0IROZbyY0H")
  startDate       DateTime? // Inicio del cursillo (1 abril)
  endDate         DateTime? // Fin del cursillo (1 mayo)
  totalSessions   Int    @default(4) // Clases programadas en el mes
  sessionSchedule String? // Ej: "Lunes y Miércoles 15:00-17:00"

  // Control
  academicYear String  @default("2026-2027")
  isActive     Boolean @default(true)
  description  String?

  // Inscripciones de estudiantes
  enrollments CursilloEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectCode, gradeLevel, specialty, academicYear])
  @@index([gradeLevel])
  @@index([academicYear])
  @@map("cursillo_sessions")
}

// Matrícula de un estudiante en una sesión/materia del cursillo
model CursilloEnrollment {
  id String @id @default(uuid())

  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  sessionId String
  session   CursilloSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Asistencia (de totalSessions del session)
  attendedSessions Int @default(0)

  // Calificación (sobre 10)
  score Decimal? // null = aún no evaluado

  // Resultado de esta materia específica
  // Se aprueba con >= 80% asistencia Y score >= 7
  passed Boolean? // null = pendiente

  notes String?

  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([applicationId, sessionId])
  @@index([applicationId])
  @@index([sessionId])
  @@map("cursillo_enrollments")
}

// ========================================
// ADDITIONAL CONTACTS
// ========================================

model ExtraContact {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  cedula       String
  firstName    String
  lastName     String
  email        String? // Opcional
  phone        String
  relationship String // Ej: "Abuelo/a", "Tío/a", "Hermano/a", "Otro"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("extra_contacts")
}

// ========================================
// AUDIT LOGS MODULE
// ========================================

model AuditLog {
  id       String  @id @default(uuid())
  action   String // Ej: "APPROVE_APPLICATION", "CREATE_USER", "UPDATE_QUOTA"
  entity   String // Ej: "Application", "User", "AdmissionQuota"
  entityId String? // ID del registro afectado
  details  Json? // Información adicional (cambios realizados, etc)

  userId    String? // Quién realizó la acción
  userEmail String? // Email para referencia rápida
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([entityId])
  @@map("audit_logs")
}

// ========================================
// SYSTEM CONFIGURATION
// ========================================

model SystemConfig {
  id          String  @id @default(uuid())
  key         String  @unique // Ej: "CURRENT_ACADEMIC_YEAR", "ADMISSION_OPEN"
  value       String
  description String?

  updatedAt DateTime @updatedAt
  updatedBy String? // ID del admin que cambió la config

  @@map("system_configs")
}

// Form Field Configuration for dynamic form builder
model FormFieldConfig {
  id            String   @id @default(uuid())
  fieldKey      String   @unique // e.g., "gradeLevel", "specialty", "relationship"
  fieldType     String   @default("select") // text, select, checkbox, textarea, number, date, email, tel
  label         String   // Display label in Spanish
  section       String   // "student", "family", "academic", "health", "documents"
  options       Json?    // Array of options for select/radio fields: [{value: "...", label: "..."}]
  isRequired    Boolean  @default(false)
  isEnabled     Boolean  @default(true)  // Can be disabled by admin
  placeholder   String?
  helpText      String?
  validationRules Json?  // {min, max, pattern, etc}
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?  // Admin who last modified

  @@index([section])
  @@index([isEnabled])
  @@map("form_field_configs")
}

// ========================================
// ACADEMIC RECORDS (Student History)
// ========================================

model AcademicRecord {
  id              String         @id @default(uuid())
  studentCedula   String         // Reference to student
  academicYear    String         // e.g. "2025-2026" (Previous year)
  gradeLevel      String         // Grade that the student coursed
  
  // Notas y promedios
  finalAverage    Decimal?       
  status          AcademicStatus @default(PASSED)
  
  // Exámenes Extraordinarios
  supletorioGrade Decimal?
  remedialGrade   Decimal?
  graciaGrade     Decimal?

  // Asignaturas reprobadas
  failedSubjectsCount Int @default(0)
  
  // Comportamiento
  behaviorGrade   String? // A, B, C, D, E

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([studentCedula, academicYear])
  @@index([studentCedula])
  @@map("academic_records")
}
